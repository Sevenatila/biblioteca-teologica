# ============================================================================
# Variáveis de ambiente — cole na Vercel (Settings → Environment Variables)
# ============================================================================
# Nada disso vai pro navegador. Se alguma dessas chaves aparecer no HTML,
# tem coisa errada.

# ── As duas obrigatórias ────────────────────────────────────────────────────

# 1. Banco. No Supabase: Settings → Database → Connection string → modo
#    "Transaction" (a do POOLER, porta 6543). A conexão direta na 5432 estoura
#    o limite em serverless, porque cada requisição abre uma conexão nova.
POSTGRES_URL=postgresql://postgres.xxxx:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 2. Senha do /painel. É o login inteiro — não tem usuário.
PAINEL_SENHA=troque-por-uma-senha-longa

# ── Opcionais ───────────────────────────────────────────────────────────────

# Segredo de assinatura do JWT. Sem ela, é derivado de PAINEL_SENHA (ver
# api/_auth.js) — que é o que permite o painel subir com só duas variáveis.
# Defina se quiser separar as duas coisas.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Só precisa se o quiz for servido em outro domínio que não o da Vercel.
# Previews *.vercel.app e localhost já passam sem configurar.
ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com
